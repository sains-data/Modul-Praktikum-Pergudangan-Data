# Salin menjadi .env di akar repositori, lalu sesuaikan nilainya.
#
# PERINGATAN: .env berisi kata sandi dan TIDAK BOLEH masuk repositori.
# Kredensial yang pernah ter-commit tetap ada pada riwayat Git meskipun
# berkasnya kemudian dihapus.

# --- Gudang data (tujuan) ----------------------------------------------------
DW_HOST=localhost
DW_PORT=5434
DW_NAME=nusamart_dw
DW_USER=praktikum
DW_PASSWORD=ganti-nilai-ini

# --- Sumber operasional ------------------------------------------------------
# Ketiganya berada pada container postgres_source yang sama, sebagai tiga
# basis data terpisah.
SRC_HOST=localhost
SRC_PORT=5433
SRC_USER=praktikum
SRC_PASSWORD=ganti-nilai-ini
SRC_DB_OLTP=nusamart_oltp
SRC_DB_BARAT=nusamart_barat
SRC_DB_TIMUR=nusamart_timur

# --- Alamat dari DALAM jaringan Docker ---------------------------------------
# Dipakai oleh postgres_fdw, yang berjalan di dalam container gudang.
# Bukan localhost:5433 milik laptop -- kekeliruan ini menimbulkan pesan
# "could not connect to server" yang membingungkan karena koneksi dari
# DBeaver jelas berhasil.
FDW_HOST=postgres_source
FDW_PORT=5432


# --- Superset (port 8088) ----------------------------------------------------
# Bangkitkan nilai acak, misalnya dengan:  openssl rand -base64 42
SUPERSET_SECRET_KEY=ganti-dengan-nilai-acak-yang-panjang
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=ganti-nilai-ini