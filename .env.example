# =============================================================================
# Salin menjadi .env di direktori yang sama dengan docker-compose.yml.
#
# PERINGATAN: .env memuat kata sandi dan TIDAK BOLEH masuk repositori.
# Kredensial yang pernah ter-commit tetap ada pada riwayat Git meskipun
# berkasnya kemudian dihapus.
# =============================================================================

# --- Sumber operasional (postgres_source, port 5433) -------------------------
SRC_USER=praktikum
SRC_PASSWORD=ganti-nilai-ini

# --- Gudang data (postgres_dw, port 5434) ------------------------------------
DW_USER=praktikum
DW_PASSWORD=ganti-nilai-ini

# --- Superset (port 8088) ----------------------------------------------------
# Bangkitkan nilai acak, misalnya dengan:  openssl rand -base64 42
SUPERSET_SECRET_KEY=ganti-dengan-nilai-acak-yang-panjang
SUPERSET_ADMIN=admin
SUPERSET_ADMIN_PASSWORD=ganti-nilai-ini
